rules_version = '2';

// RisparmIA: ogni utente vede e scrive solo i propri documenti.
// I contenuti sono cifrati lato client (AES-GCM): il server conserva solo
// blob illeggibili, metadati minimi e la data di aggiornamento.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Documento cifrato: solo i campi previsti, dimensione limitata.
    function isEncryptedBlob() {
      return request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'updatedAt'])
        && request.resource.data.v is int
        && request.resource.data.iv is string && request.resource.data.iv.size() < 64
        && request.resource.data.ct is string && request.resource.data.ct.size() < 1000000
        && request.resource.data.updatedAt == request.time;
    }

    // Parametri di derivazione della chiave (sale e verificatore): non segreti.
    function isCryptoMeta() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'salt', 'iterations', 'check', 'updatedAt'])
        && d.v is int
        && d.salt is string && d.salt.size() < 64
        && d.iterations is int && d.iterations >= 600000 && d.iterations <= 2000000
        && d.check is map && d.check.keys().hasOnly(['v', 'iv', 'ct'])
        && d.check.iv is string && d.check.iv.size() < 64
        && d.check.ct is string && d.check.ct.size() < 256
        && d.updatedAt == request.time;
    }

    // Il sale si scrive una volta sola: sovrascriverlo renderebbe illeggibili
    // per sempre i dati cifrati con la chiave precedente. Un futuro "cambio
    // passphrase" dovrà ricifrare tutto in modo atomico.
    match /users/{uid}/meta/crypto {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isCryptoMeta();
      allow update: if false;
    }

    match /users/{uid}/vault/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isEncryptedBlob()
        && docId.matches('^(settings|rules|tx-[0-9]{4}-[0-9]{2})$');
    }

    // Tutto il resto è negato.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
