# Copia questo file in .env.local (ignorato da git) e compila con i valori
# del tuo progetto Firebase: Console > Impostazioni progetto > Le tue app > SDK.
# Nota: la configurazione web di Firebase non è un segreto (finisce comunque nel
# bundle pubblicato), ma la teniamo fuori dal repo per non legare il codice a un
# progetto specifico. La sicurezza dei dati è garantita dalle regole Firestore e
# dalla cifratura lato client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
