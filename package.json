{
  "name": "risparmia",
  "version": "0.1.0",
  "private": true,
  "description": "PWA per la gestione del portafoglio familiare con motore attivo di strategie di risparmio. Dati cifrati end-to-end su Firebase.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
