{
  "name": "risparmia",
  "version": "0.1.0",
  "private": true,
  "description": "PWA per la gestione del portafoglio familiare con motore attivo di strategie di risparmio. Dati cifrati end-to-end su Firebase.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
